# Profilo LMS (macchina 10.0.0.241, istanza MULTIDB_2022)
# Copia in DB/.env oppure: set -a; source mssql-lms.env.example; set +a; ./probe-mssql.sh
#
# Da Rocky/Linux serve autenticazione SQL (non Windows).
# Creare un login SQL readonly su lms_010 sulla macchina LMS.

MSSQL_HOST=10.0.0.241
MSSQL_PORT=49543
MSSQL_INSTANCE=MULTIDB_2022
MSSQL_DATABASE=lms_010
MSSQL_USER=
MSSQL_PASSWORD=
