# Profilo DVK_3W-MOA6-8C (macchina 10.0.0.238)
# Copia in DB/.env dopo setup-mssql-readonly.ps1 (-DiscoverOnly per porta/database)
#
# Esegui sulla DVK (PowerShell admin):
#   .\setup-mssql-readonly.ps1 -HostIp 10.0.0.238 -DiscoverOnly
#   .\setup-mssql-readonly.ps1 -HostIp 10.0.0.238 -Database NOME_DB -Password "..."

MSSQL_HOST=10.0.0.238
MSSQL_PORT=1433
MSSQL_INSTANCE=
MSSQL_DATABASE=
MSSQL_USER=catis_readonly
MSSQL_PASSWORD=
