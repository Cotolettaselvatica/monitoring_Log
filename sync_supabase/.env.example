# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
#
# Connessione diretta (solo IPv6):
# postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres.davdmvtbwdvughepcslt:YOUR-PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

